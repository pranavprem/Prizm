# Copy to .env if you want to override the defaults.
# The app runs with SQLite and no .env file.

PRIZM_DB_DRIVER=sqlite
PRIZM_DB_PATH=data/prizm.sqlite

# Uncomment to use MySQL. Create the database first (the 2017 name was 272project).
# PRIZM_DB_DRIVER=mysql
# PRIZM_DB_HOST=127.0.0.1
# PRIZM_DB_PORT=3306
# PRIZM_DB_NAME=272project
# PRIZM_DB_USER=prizm
# PRIZM_DB_PASS=

# Sample shopper created on the first run. Change these before that first run
# if you do not want the README defaults. Set PRIZM_SEED=0 to skip the sample data.
PRIZM_SEED=1
PRIZM_DEMO_EMAIL=demo@prizm.test
PRIZM_DEMO_PASSWORD=demo

# Comma-separated JSON feeds from partner shops. Each feed is the shape
# exposeproducts.php returns. TLS certificates are verified.
# PRIZM_PEER_URLS=https://shop-a.example/exposeproducts.php,https://shop-b.example/exposeproducts.php
