{
    "name": "pranavprem/prizm",
    "description": "Shared catalog and cart from the Valar Shopoholics class project.",
    "type": "project",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "serve": "php -S localhost:8080 router.php"
    },
    "config": {
        "sort-packages": true
    }
}
